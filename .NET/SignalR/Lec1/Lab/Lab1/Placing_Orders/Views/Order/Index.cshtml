@model List<Order>
@{
    ViewData["Title"] = "Orders";
}

<h2 class="fw-bold">Order List</h2>
<table class="table" id="orderTable">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Item</th>
            <th>Count</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.ItemName</td>
                <td>@item.Count</td>
                <td>
                    <button class="btn btn-primary">Edit</button>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>

    <script>
        var conn = new signalR.HubConnectionBuilder().withUrl("/orderHub").build();

        conn.on("NeworderReceived", function(order){
        var row = `<tr>
        <td>${order.id}</td>
        <td>${order.name}</td>
        <td>${order.itemName}</td>
        <td>${order.count}</td>
        <td><button class="btn btn-primary">Edit</button></td>
        </tr>`;

        document.querySelector("#orderTable tbody").innerHTML += row;
        });

        conn.start().catch(function(err) {
        return console.error(err.toString());
        });

    </script>
}