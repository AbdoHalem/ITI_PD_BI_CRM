@using Lab3.Models
@using Lab3.Services

@page "/students"

@* Inject the services we need *@
@inject IStudentService StudentService
@inject NavigationManager NavManager

<div class="container mt-4">
    <h2 class="mb-4">All Students</h2>

    @if (studentsList == null)
    {
        <div class="alert alert-info">Loading students from API...</div>
    }
    else if (!studentsList.Any())
    {
        <div class="alert alert-warning">No students found.</div>
    }
    else
    {
        <table class="table table-striped table-bordered shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>First Name</th>
                    <th>Last Name</th>
                    <th>Age</th>
                    <th>Address</th>
                    <th>Department</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @* Loop through the list of students retrieved from the API *@
                @foreach (var std in studentsList)
                {
                    <tr>
                        <td>@std.St_Id</td>
                        <td>@std.St_Fname</td>
                        <td>@std.St_Lname</td>
                        <td>@std.St_Age</td>
                        <td>@std.St_Address</td>
                        <td>@std.Dept_Name</td>
                        <td>
                            @* Event Binding: Navigate to the Edit page passing the student ID *@
                            <button class="btn btn-warning btn-sm" @onclick="() => GoToEdit(std.St_Id)">
                                Edit
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
