@model IEnumerable<Course>
@{
    // Layout = null;
	ViewBag.Title = "Courses";
}

    <a asp-action="create" class="btn btn-danger">Create</a>
    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th>Course Id</th>
                <th>Name</th>
                <th>Duration</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Model == null || Model.Count() == 0)
            {
                <tr>
                    <td colspan="4" class="text-center">No data found</td>
                </tr>
            }
            else
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.CrsId</td>
                        <td>@item.Name</td>
                        <td>@item.Duration</td>
                        <td>
                            @* <a href="/department/details/@item.DeptId" class="btn btn-info">Details</a> *@
                            <a asp-controller="Course" asp-action="UpdateDegrees" asp-route-id="@item.CrsId" class="btn btn-info">Update Degrees</a>
                            @* <a asp-controller="Department" asp-action="Edit" asp-route-id="@item.DeptId" class="btn btn-danger">Edit</a> *@
                            
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

