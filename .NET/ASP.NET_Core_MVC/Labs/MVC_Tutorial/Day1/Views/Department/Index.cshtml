@model IEnumerable<Department>
@{
    // Layout = null;
	ViewBag.Title = "Departments";
}

    <a asp-action="create" class="btn btn-danger">Create</a>
    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th>DepartmentId</th>
                <th>Name</th>
                <th>Capacity</th>
				<th></th>
            </tr>
        </thead>
        <tbody>
            @if(Model == null || Model.Count() == 0)
            {
                <tr>
                    <td colspan="4" class="text-center">No data found</td>
                </tr>
            }
            else
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.DeptId</td>
                        <td>@item.DeptName</td>
                        <td>@item.Capacity</td>
                        <td>
                            @* <a href="/department/details/@item.DeptId" class="btn btn-info">Details</a> *@
                            <a asp-controller="Department" asp-action="Details" asp-route-id="@item.DeptId" class="btn btn-info">Details</a>
                            <a asp-controller="Department" asp-action="Edit" asp-route-id="@item.DeptId" class="btn btn-danger">Edit</a>
                            @* <a asp-controller="Department" asp-action="Delete" asp-route-id="@item.DeptId" onclick="return confirm('Are you sure?')" class="btn btn-danger">Delete</a> *@
                            <a asp-controller="Department" asp-action="Delete" asp-route-id="@item.DeptId" class="btn btn-danger">Delete</a>
                            <a asp-controller="Department" asp-action="ShowCourses" asp-route-id="@item.DeptId" class="btn btn-danger">Show Courses</a>
                            <a asp-controller="Department" asp-action="ManageDeptCourses" asp-route-id="@item.DeptId" class="btn btn-danger">Manage Courses</a>

                        </td>
                    </tr>
                }
            }
		</tbody>
	</table>
